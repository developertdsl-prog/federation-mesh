{
  "name": "federation-mesh",
  "version": "1.0.0",
  "description": "High-Performance Distributed GraphQL Subgraph Router, Schema Composition Engine & Query Planner",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "seed": "node server/utils/seedSubgraphs.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "graphql",
    "federation",
    "supergraph",
    "subgraph",
    "query-planner",
    "dataloader",
    "api-gateway",
    "distributed-systems"
  ],
  "author": "developertdsl-prog <developer.tdsl@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dataloader": "^2.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "mongoose": "^7.6.3",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/server/tests/**/*.test.js"
    ],
    "verbose": true,
    "testTimeout": 10000
  }
}
